# Copy to .env in the repo root. run_benchmark.sh loads it automatically.
# Already-exported shell variables are not overwritten. CLI flags still win.

# --- Generation (answer model) ---
GENERATION_API_KEY="xxx"
GENERATION_BASE_URL="https://openrouter.ai/api/v1"
GENERATION_MODEL="qwen/qwen3-8b"
# GENERATION_MODELS="qwen/qwen3-8b,deepseek-v4-flash"

# --- Judge ---
JUDGE_API_KEY="xxx"
JUDGE_BASE_URL="https://api.deepseek.com"
JUDGE_MODEL="deepseek-v4-flash"

# --- Memory construction / retrieval ---
MEMORY_API_KEY="xxx"
MEMORY_BASE_URL="https://api.deepseek.com"
MEMORY_LLM_MODEL="deepseek-v4-flash"

MEMORY_EMBEDDING_API_KEY="xxx"
MEMORY_EMBEDDING_BASE_URL="https://openrouter.ai/api/v1"
MEMORY_EMBEDDING_MODEL="baai/bge-m3"
MEMORY_EMBEDDING_DIMS="1024"

# --- Thinking: generation and judge are independent ---
# 0/false = off (default). 1/true = on.
# Each side sends both reasoning.enabled (OpenRouter) and thinking.type
# (DeepSeek official). ENABLE_THINKING is only a fallback if the
# role-specific variable is unset.
GENERATION_ENABLE_THINKING=0
JUDGE_ENABLE_THINKING=0
# ENABLE_THINKING=0

# --- Optional run defaults (CLI still overrides) ---
# TASKS="objective_fact_judgment"
# METHODS="RawDialogue,NoMemory"
# LIMIT=20
# EVAL_CURRENT_DATE="2025-06-01"
# ANSWER_SYSTEM_EXTRA_INSTRUCTION=""
